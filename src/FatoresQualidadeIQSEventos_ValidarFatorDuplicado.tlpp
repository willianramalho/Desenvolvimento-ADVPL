/*/{Protheus.doc} validateFactorDuplicate
Bloqueia gravacao quando ja existir outro registro com a mesma
combinacao de QEJ_CODTAB e QEJ_FATOR, desconsiderando nCurRecno
(0 na inclusao, recno do proprio registro na alteracao). Usa a ordem
2 de QEJ (QEJ_FILIAL+QEJ_CODTAB+QEJ_FATOR) e preenche cFactor ate o
tamanho de QEJ_FATOR (TamSX3) para o seek posicionar corretamente em
campos de tamanho fixo.
@type method
@author willian.ramalho
@since 25/08/2026
@param oData, object, Dados da operacao
@param oError, object, Retorno de erro
@param nCurRecno, numeric, Recno desconsiderado na checagem (0 = nenhum)
@return logical, Ausencia de duplicidade
/*/
method validateFactorDuplicate(oData as object, oError as object, nCurRecno as numeric) as logical class QualityFactorsIQSEvents

    Local aAreaQEJ   := QEJ->(GetArea())                        as array
    Local cFilQEJ    := xFilial("QEJ")                          as character
    Local cFactor    := oData:getFieldValue("QEJ", "QEJ_FATOR") as character
    Local cFactorPad := PadR(cFactor, TamSX3("QEJ_FATOR")[1])   as character
    Local lValid     := .T.                                     as logical

    If !FWSIXUtil():ExistIndex("QEJ", "2")
        // STR0003 - "Indice de QEJ desatualizado"
        // STR0004 - "Aplique a atualizacao de dicionario (RUP_QIE) antes de gravar Fatores."
        oError:set(400, OemToAnsi(STR0003), OemToAnsi(STR0004))
        RestArea(aAreaQEJ)
        Return .F.
    EndIf

    QEJ->(DbSetOrder(2)) //QEJ_FILIAL+QEJ_CODTAB+QEJ_FATOR
    If QEJ->(DbSeek(cFilQEJ + ::cCodTab + cFactorPad))
        While !QEJ->(Eof()) .And. QEJ->QEJ_FILIAL == cFilQEJ .And. ;
            QEJ->QEJ_CODTAB == ::cCodTab .And. QEJ->QEJ_FATOR == cFactorPad
            If QEJ->(Recno()) <> nCurRecno
                // STR0001 - "Fator ja cadastrado"
                // STR0002 - "Fator deve ser numerico, positivo e nao pode estar cadastrado na tabela (Help legado JAGRAVADO)."
                oError:set(400, OemToAnsi(STR0001), OemToAnsi(STR0002))
                lValid := .F.
                Exit
            EndIf
            QEJ->(DbSkip())
        EndDo
    EndIf

    RestArea(aAreaQEJ)

return lValid
