/*/{Protheus.doc} setModel
Filtra QEJ por QEJ_CODTAB="1" (Fatores I.A.), igual ao filtro
q270FilFat()/uCodTab="1" do legado (QIEA270 com nOpcao=1).
@type method
@author willian.ramalho
@since 25/08/2026
/*/
method setModel() class QualityFactorsIAModel
    Local oEvents as object
    Local oObject as object

    oObject := ObjectFromMetadata():new("QEJ", Nil, Nil, "QEJ_CODTAB eq '1'")
    ::setObject(oObject:getObject(), "QEJ")

    // Oculta QEJ_CODTAB no browse/formulario
    ::setProperty("QEJ_CODTAB", "hidden", .T., "QEJ")

    oEvents := QualityFactorsIAEvents():new()
    ::setEvents(oEvents)
return
