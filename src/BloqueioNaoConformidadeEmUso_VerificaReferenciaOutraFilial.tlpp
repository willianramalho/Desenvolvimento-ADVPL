/*/{Protheus.doc} hasReferenceInOtherBranch
Consulta a referencia em uma filial diferente da corrente, reproduzindo a
varredura por QA_RetFilEmp do legado. Mantem os mesmos criterios aplicados
por QLTQueryManager():dbSeek (filtro de filial, chave e D_E_L_E_T_) e
posiciona o alias no registro encontrado.
@type method
@author willian.ramalho
@since 18/08/2026
@param cAlias, character, Alias consultado (QE2/QP2/QE9/QP9/QEU/QPU)
@param cBranch, character, Filial pesquisada
@param cCode, character, Codigo da nao conformidade (AG_NAOCON)
@return logical, Existe referencia no alias para a filial informada
/*/
method hasReferenceInOtherBranch(cAlias as character, cBranch as character, cCode as character) as logical class NonconformitiesEvents

    Local aBindParam := {}  as array
    Local cAliasQry  := ""  as character
    Local cQuery     := ""  as character
    Local lFound     := .F. as logical

    DbSelectArea(cAlias)

    cQuery := " SELECT R_E_C_N_O_ "
    cQuery += " FROM " + RetSQLName(cAlias)
    cQuery += " WHERE ? = ? AND ? = ? AND D_E_L_E_T_ = ? "

    AAdd(aBindParam, {cAlias + "_FILIAL", "U"})
    AAdd(aBindParam, {cBranch           , "S"})
    AAdd(aBindParam, {cAlias + "_NAOCON", "U"})
    AAdd(aBindParam, {cCode             , "S"})
    AAdd(aBindParam, {" "               , "S"})

    cAliasQry := QLTQueryManager():executeQueryWithBind(cQuery, aBindParam, .T.)

    (cAliasQry)->(DbGoTop())
    If (cAliasQry)->(!Eof())
        (cAlias)->(DbGoTo((cAliasQry)->R_E_C_N_O_))
        lFound := !(cAlias)->(Eof())
    EndIf
    (cAliasQry)->(DbCloseArea())

return lFound
