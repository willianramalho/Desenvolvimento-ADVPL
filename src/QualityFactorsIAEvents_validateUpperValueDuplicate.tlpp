/*/{Protheus.doc} validateUpperValueDuplicate
Bloqueia gravacao quando ja existir outro registro com a mesma
combinacao de QEJ_CODTAB e QEJ_VLSUP, desconsiderando nCurRecno
(0 na inclusao, recno do proprio registro na alteracao). Usa a
ordem 1 de QEJ (QEJ_FILIAL+QEJ_CODTAB+STR(QEJ_VLSUP,6,2)), a mesma
ja usada por recalcLowerBound -- sem depender de indice novo.
Substitui a checagem ExistChav que existia em
validateQEJUpperValueSmartX (qualityfactortables.valids.tlpp): um
serverValidate de campo isolado nao tem acesso confiavel ao recno
do registro em edicao para excluir o proprio registro da checagem
(mesmo motivo que ja tinha tirado a checagem de duplicidade de
QEJ_FATOR de la).
@type method
@author willian.ramalho
@since 31/08/2026
@param oData, object, Dados da operacao
@param oError, object, Retorno de erro
@param nCurRecno, numeric, Recno desconsiderado na checagem (0 = nenhum)
@return logical, Ausencia de duplicidade
/*/
method validateUpperValueDuplicate(oData as object, oError as object, nCurRecno as numeric) as logical class QualityFactorsIAEvents

    Local aAreaQEJ := QEJ->(GetArea())                        as array
    Local cFilQEJ  := xFilial("QEJ")                          as character
    Local nUpper   := oData:getFieldValue("QEJ", "QEJ_VLSUP") as numeric
    Local lValid   := .T.                                     as logical

    QEJ->(DbSetOrder(1)) //QEJ_FILIAL+QEJ_CODTAB+STR(QEJ_VLSUP,6,2)
    If QEJ->(DbSeek(cFilQEJ + ::cCodTab + Str(nUpper, 6, 2)))
        While !QEJ->(Eof()) .And. QEJ->QEJ_FILIAL == cFilQEJ .And. ;
            QEJ->QEJ_CODTAB == ::cCodTab .And. QEJ->QEJ_VLSUP == nUpper
            If QEJ->(Recno()) <> nCurRecno
                // STR0005 - "Limite superior ja cadastrado"
                // STR0006 - "Limite superior ja cadastrado para esta tabela (Help legado JAGRAVADO)."
                oError:set(400, OemToAnsi(STR0005), OemToAnsi(STR0006))
                lValid := .F.
                Exit
            EndIf
            QEJ->(DbSkip())
        EndDo
    EndIf

    RestArea(aAreaQEJ)

return lValid
